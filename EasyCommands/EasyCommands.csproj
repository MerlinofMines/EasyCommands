<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>IngameScript</RootNamespace>
    <AssemblyName>EasyCommands</AssemblyName>
    <LangVersion>6</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <MdkBuildConfiguration>Release</MdkBuildConfiguration>
    <MdkInteractive>DoNothing</MdkInteractive>
    <MdkArguments>-output "$(MSBuildProjectDirectory)\bin\$(Configuration)\MDK"</MdkArguments>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mal.Mdk2.PbAnalyzers" Version="2.2.0" PrivateAssets="all" />
    <PackageReference Include="Mal.Mdk2.PbPackager" Version="2.2.10" PrivateAssets="all" />
    <PackageReference Include="Mal.Mdk2.References" Version="2.2.9" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="MDK\**\*.cs" />
    <AdditionalFiles Include="Instructions.readme" />
    <AdditionalFiles Include="thumb.png" />
  </ItemGroup>
  <Target Name="RedactPackedScriptVisibility" AfterTargets="MdkPack"
          Condition="'$(Configuration)' == '$(MdkBuildConfiguration)' Or '$(MdkBuildConfiguration)' == 'all'">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)\..\build\Redact-ScriptVisibility.ps1&quot; -ScriptPath &quot;$(MSBuildProjectDirectory)\bin\$(Configuration)\MDK\$(MSBuildProjectName)\script.cs&quot;" />
  </Target>
</Project>
