<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <SpaceEngineersBinCopyLocal>true</SpaceEngineersBinCopyLocal>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="2.1.2" />
    <PackageReference Include="MSTest.TestFramework" Version="2.1.2" />
    <PackageReference Include="Moq" Version="4.16.0" />
    <PackageReference Include="Mal.Mdk2.References" Version="2.2.9" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\EasyCommands\EasyCommands.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Content Include="../integration/scenarios/*.json" Link="scenarios/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup>
    <BridgeTestGeneratedSource>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)$(Configuration)/$(Platform)/BridgeProgram.g.cs</BridgeTestGeneratedSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(BridgeTestGeneratedSource)" />
  </ItemGroup>
  <Target Name="GenerateBridgeTestHost" BeforeTargets="CoreCompile"
          Inputs="$(MSBuildProjectDirectory)/../EasyCommands.Bridge/script.cs.txt;$(MSBuildProjectDirectory)/../build/Wrap-BridgeForTests.ps1"
          Outputs="$(BridgeTestGeneratedSource)">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/../build/Wrap-BridgeForTests.ps1&quot; -SourcePath &quot;$(MSBuildProjectDirectory)/../EasyCommands.Bridge/script.cs.txt&quot; -OutputPath &quot;$(BridgeTestGeneratedSource)&quot;" />
  </Target>
</Project>
